# Copy to .env.local. Without Supabase the app runs in demo mode (in-memory data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Meta (Facebook + Instagram) — OAuth routes LIVE: /api/auth/facebook + callback.
# Redirect URI to paste in Meta App: https://mentionhub-ghorowa.vercel.app/api/auth/facebook/callback
META_APP_ID=
META_APP_SECRET=
# YouTube — Google Cloud OAuth client. OAuth routes LIVE: /api/auth/google + callback.
# Redirect URI to paste in Google Cloud: https://mentionhub-ghorowa.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override redirect base (default = request host, or mentionhub-ghorowa.vercel.app).
OAUTH_REDIRECT_BASE=https://mentionhub-ghorowa.vercel.app
# YouTube Data API key (for Profile Checker live lookup, separate from OAuth).
YOUTUBE_API_KEY=
# Stripe (international billing) — bKash manual payment is handled in /app billing notes in v1.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
