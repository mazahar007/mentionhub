# Copy to .env.local. Without Supabase the app runs in demo mode (in-memory data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Meta (Facebook + Instagram) — create a Meta App, then fill these. OAuth routes are stubs in v1.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://YOUR-DOMAIN/api/auth/meta/callback
# YouTube — Google Cloud OAuth client for the YouTube Data API v3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/auth/google/callback
# Stripe (international billing) — bKash manual payment is handled in /app billing notes in v1.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
